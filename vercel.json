{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "90project.online"
        }
      ],
      "destination": "https://www.90project.online/:path*",
      "permanent": true
    }
  ]
}
